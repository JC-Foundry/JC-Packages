<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>JC.Github</PackageId>
        <Version>6.0.1</Version>
        <Description>Turns GitHub into the issue tracker for an application's own bug reports, in both directions. Outbound, BugReportService persists a ReportedIssue locally and then creates the matching GitHub issue through a timeout-bounded REST client; the local record is saved either way, so a GitHub outage loses nothing. Inbound, an optional webhook endpoint at a configurable path validates GitHub's HMAC-SHA256 signature in fixed time, acknowledges pings, ignores pull-request and issue-less deliveries, and folds issue and comment events back into the local records so state and discussion stay in step. Reported issues and comments are stored through JC.Core against a DbContext you nominate.</Description>
        <PackageTags>$(PackageTags);github;issue-tracking;bug-reports;webhooks</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' == 'true'">
        <ProjectReference Include="..\JC.Core\JC.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' != 'true'">
        <PackageReference Include="JC.Core" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Flurl.Http" VersionOverride="4.0.2" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    </ItemGroup>
    <!-- The README ships in the package: it is the landing page on a feed, and the
         project's front page on GitHub. Update rather than Include - the SDK's default
         globs already pick .md up as None. -->
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
