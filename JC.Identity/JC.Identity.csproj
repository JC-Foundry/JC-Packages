<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>JC.Identity</PackageId>
        <Version>6.0.0</Version>
        <Description>ASP.NET Core Identity wired into the JC suite. IdentityDataDbContext extends IdentityDbContext and implements JC.Core's IDataDbContext, so identity, tenants and the audit trail share one context and every change is attributed to the signed-in user. Multi-tenancy is enforced by global query filters reading the current tenant per query rather than caching it at model build. A claims factory projects twelve fields from your BaseUser onto the principal, and middleware reads them back into IUserInfo — the contract the rest of the suite depends on for attribution and tenant scoping. Further middleware enforces disabled accounts, forced password changes and optional two-factor, skipping static files and configured paths, and helpers seed system roles and a default administrator from configuration.</Description>
        <PackageTags>$(PackageTags);identity;authentication;claims;multi-tenancy;aspnetcore</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" VersionOverride="9.0.17" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' == 'true'">
        <ProjectReference Include="..\JC.Identity.Shared\JC.Identity.Shared.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' != 'true'">
        <PackageReference Include="JC.Identity.Shared" versionOverride="6.0.0"/>
    </ItemGroup>
    <!-- The README ships in the package: it is the landing page on a feed, and the
         project's front page on GitHub. Update rather than Include - the SDK's default
         globs already pick .md up as None. -->
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
