<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>JC.Identity</PackageId>
        <Version>7.1.0</Version>
        <Description>ASP.NET Core Identity wired into the JC suite. One AddIdentity call registers Identity with Entity Framework stores, default token providers and an application cookie defaulting to the /Identity/Account paths; AddIdentityServices registers only the JC half where Identity is already configured elsewhere. IdentityDataDbContext extends IdentityDbContext and implements JC.Core's IDataDbContext, so identity and the audit trail share one context and every change is attributed to the signed-in user — it deliberately does not filter by tenant, which is what lets a single-tenant application skip JC.Tenancy entirely. BaseUser adds a display name, login and registration timestamps, an enabled flag and a forced-password-change flag on top of IdentityUser, and implements JC.Core's IApplicationUser so the record can be read without referencing ASP.NET Identity. A claims factory projects thirteen of those fields onto the principal for JC.Identity.Shared to read back into IUserInfo, and the claim types it uses are copied from whatever the application configured rather than assumed. UseIdentity composes the pipeline in the order it has to run, and helpers seed a default administrator from configuration alongside the roles declared on SystemRoles, which an application extends with its own and which this package owns because local administrative roles are its security domain rather than a shared one. Seeding returns that administrator, so a tenant can be assigned to it afterwards.</Description>
        <PackageTags>$(PackageTags);identity;authentication;claims;roles;aspnetcore;efcore</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
      <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" VersionOverride="9.0.19" />
    </ItemGroup>

    <!-- Both halves of the shared runtime: the projection and rules, and the middleware that
         wraps them. JC.Identity is an ASP.NET Core package either way. -->
    <ItemGroup Condition="'$(UseLocalProjectReferences)' == 'true'">
        <ProjectReference Include="..\JC.Identity.Shared\JC.Identity.Shared.csproj" />
        <ProjectReference Include="..\JC.Identity.Shared.Web\JC.Identity.Shared.Web.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' != 'true'">
        <PackageReference Include="JC.Identity.Shared" versionOverride="7.1.0"/>
        <PackageReference Include="JC.Identity.Shared.Web" versionOverride="7.1.0"/>
    </ItemGroup>
    <!-- The README ships in the package: it is the landing page on a feed, and the
         project's front page on GitHub. Update rather than Include - the SDK's default
         globs already pick .md up as None. -->
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
