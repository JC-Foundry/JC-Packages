<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>JC.Identity.Shared</PackageId>
        <Version>6.0.1</Version>
        <Description>The identity runtime shared by JC.Identity and any future identity authority, with no dependency on ASP.NET Core or ASP.NET Identity. UserInfoBase implements JC.Core's IUserInfo, and UserInfoExtensions projects onto it from either direction — an authoritative IApplicationUser record, or a ClaimsPrincipal read through IdentityProjectionOptions, which names the identifier, email and role claim types plus the authority to stamp, so one projection serves whichever package authenticated the user. The remaining claim types are fixed constants in DefaultClaims, written by the authority and read back here. IdentityRules evaluates the account rules — disabled accounts, forced password changes, optional two-factor — against a request path and returns a route to redirect to or nothing at all, so enforcement is plain code rather than middleware. IdentityHelper formats the otpauth:// URI and grouped shared key an authenticator setup screen needs. Role definitions are deliberately absent: an authority's administrative roles are its own security domain, so each brings its own. SetUserInfoForUser and its scope-creating overloads establish an ambient identity outside an HTTP request, so a background job takes attribution without a fake user. The ASP.NET Core middleware wrapping all of this is JC.Identity.Shared.Web.</Description>
        <PackageTags>$(PackageTags);identity;claims;user-context;two-factor</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- Deliberately no FrameworkReference on ASP.NET Core, and none on ASP.NET Identity. The
         claims projection and the identity rules are plain code over IUserInfo, so a worker
         service can take identity attribution without the ASP.NET Core runtime. The HTTP
         plumbing that wraps them lives in JC.Identity.Shared.Web. -->

    <ItemGroup Condition="'$(UseLocalProjectReferences)' == 'true'">
        <ProjectReference Include="..\JC.Core\JC.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' != 'true'">
        <PackageReference Include="JC.Core" />
    </ItemGroup>
    <!-- The README ships in the package: it is the landing page on a feed, and the
         project's front page on GitHub. Update rather than Include - the SDK's default
         globs already pick .md up as None. -->
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Authentication\" />
    </ItemGroup>
</Project>