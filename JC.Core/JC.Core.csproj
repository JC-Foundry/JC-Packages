<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>JC.Core</PackageId>
        <Version>6.0.0</Version>
        <Description>The foundation every other JC package builds on. Provides a repository and unit-of-work layer over EF Core — IRepositoryManager with typed IRepositoryContext&lt;T&gt; access, transactions, and multi-DbContext support where each context is reached through For&lt;T&gt;() and keeps its own transaction. Adds an audit trail written automatically on SaveChanges, optionally stamped with a source application name so several applications can share a database; soft-delete with query filtering; pagination; and retention cleanup jobs for audit entries and soft-deleted rows. It also owns the contracts the suite shares — IUserInfo and IApplicationUser, separating the current authenticated user from an authoritative user record, with the IdentityAuthority naming who supplied it; IBackgroundJob; and the IMultiTenancy/ITenantContext pair, which lets any package mark an entity tenant-scoped and read the tenant an operation is running against without depending on the tenancy engine that establishes it — plus helpers for strings, enums, dates, colours and countries.</Description>
        <PackageTags>$(PackageTags);repository;unit-of-work;efcore;audit-trail;soft-delete;pagination;multi-tenancy</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="JC.Identity" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    </ItemGroup>

    <!-- The README ships in the package: it is the landing page on a feed, and the
         project's front page on GitHub. Update rather than Include - the SDK's default
         globs already pick .md up as None. -->
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
