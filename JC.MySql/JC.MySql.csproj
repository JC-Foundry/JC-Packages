<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>JC.MySql</PackageId>
        <Version>6.1.0</Version>
        <Description>Registers a JC.Core DbContext against MySQL using Pomelo.EntityFrameworkCore.MySql. Takes the connection string by name from configuration (defaulting to DefaultConnection) and fails fast when it is absent, names the migrations assembly, and exposes the provider's own options for anything further. The server version is auto-detected from the connection string, so the database must be reachable at start-up. A MySQL health check can be registered alongside, opt-in. Interchangeable with JC.SqlServer — the two present the same shape, so the provider is a one-line choice.</Description>
        <PackageTags>$(PackageTags);mysql;efcore;pomelo;database-provider</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' == 'true'">
        <ProjectReference Include="..\JC.Core\JC.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' != 'true'">
        <PackageReference Include="JC.Core" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AspNetCore.HealthChecks.MySql" VersionOverride="9.0.0" />
      <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
      <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" VersionOverride="9.0.0" />
    </ItemGroup>

    <!-- The README ships in the package: it is the landing page on a feed, and the
         project's front page on GitHub. Update rather than Include - the SDK's default
         globs already pick .md up as None. -->
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
