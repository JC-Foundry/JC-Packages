<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>JC.Web</PackageId>
        <Version>6.1.0</Version>
        <Description>Hardening and helpers for ASP.NET Core applications, in five areas that register independently. Security: response-header middleware with a fluent content-security-policy builder, and cookie services in plain and Data-Protection-encrypted forms selected by keyed injection. Client profiling: per-request metadata — client IP honouring proxy headers only when told to, parsed user agent, optional geo-location — bot filtering, and log entries that mask the sensitive fields by default. Rate limiting: opt-in, wrapping the framework's limiter with fixed and sliding windows, token bucket and concurrency, partitioned by IP, user, endpoint or a pair, with static files excluded. SEO: a sitemap that discovers Razor routes and splits behind an index past the protocol limit, robots.txt, Open Graph and Twitter meta, and typed JSON-LD. UI: tag helpers and builders whose class names come from a swappable framework dictionary — Bootstrap 5, Tailwind v4 or jc-tailwind-ui — plus HTML sanitisation for user-authored content, QR codes and dropdown building.</Description>
        <PackageTags>$(PackageTags);aspnetcore;security-headers;csp;cookies;rate-limiting;seo;sitemap;tag-helpers;bot-detection;html-sanitiser</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
      <PackageReference Include="HtmlSanitizer" VersionOverride="9.1.974" />
      <PackageReference Include="QRCoder" VersionOverride="1.8.0" />
      <PackageReference Include="UAParser" VersionOverride="3.1.47" />
    </ItemGroup>

    <!-- The Tailwind safelist ships in the package: a consumer on either Tailwind framework
         imports it from their entry CSS, and it is useless to them if it stays in this repo.
         Update rather than Include — the SDK's default globs already pick .css up as None. -->
    <ItemGroup>
      <None Update="UI\jc-web.tailwind.css" Pack="true" PackagePath="contentFiles\any\any\jc-web.tailwind.css" PackageCopyToOutput="false" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' == 'true'">
        <ProjectReference Include="..\JC.Core\JC.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' != 'true'">
        <PackageReference Include="JC.Core" />
    </ItemGroup>
    <!-- The README ships in the package: it is the landing page on a feed, and the
         project's front page on GitHub. Update rather than Include - the SDK's default
         globs already pick .md up as None. -->
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
