<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>JC.BackgroundJobs</PackageId>
        <Version>6.0.0</Version>
        <Description>Background job hosting for .NET applications, built on the single IBackgroundJob contract defined in JC.Core. Two independent paths share it: lightweight in-process recurring jobs hosted on BackgroundService, with configurable interval, initial delay, DI lifetime, error behaviour and log verbosity; and Hangfire-backed recurring jobs with cron, queue, time zone and misfire options, plus an ad-hoc scheduler for fire-and-forget, delayed and continuation work. Both paths support a per-run execution timeout, and closed generic jobs are named distinctly so per-context registrations cannot collide. Hangfire storage is registered separately.</Description>
        <PackageTags>$(PackageTags);background-jobs;hangfire;hosted-service;cron;scheduling</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' == 'true'">
        <ProjectReference Include="..\JC.Core\JC.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' != 'true'">
        <PackageReference Include="JC.Core" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Hangfire.Core" VersionOverride="1.8.23" />
      <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    </ItemGroup>

    <!-- The README ships in the package: it is the landing page on a feed, and the
         project's front page on GitHub. Update rather than Include - the SDK's default
         globs already pick .md up as None. -->
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
