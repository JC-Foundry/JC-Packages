<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>JC.Communication.Web</PackageId>
        <Version>7.1.0</Version>
        <Description>ASP.NET Core Razor tag helpers rendering JC.Communication's features: a notification bell with dropdown, a standalone unread badge, notification toasts, a chat thread view, a chat list with unread counts, a message compose box, a participant list, and a contact form. No class name or icon is hardcoded — both are read from per-package dictionaries selected by the configured CSS framework (Bootstrap 5, Tailwind v4, or jc-tailwind-ui) and icon set (Bootstrap Icons or Font Awesome 6), which are independent choices. Ships a Tailwind safelist so the class names survive Tailwind's scanner, which cannot see them inside a compiled assembly.</Description>
        <PackageTags>$(PackageTags);aspnetcore;razor;tag-helpers;notifications;messaging;bootstrap;tailwind</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <!-- The Tailwind safelist ships in the package: a consumer on either Tailwind framework
         imports it from their entry CSS, and it is useless to them if it stays in this repo.
         Update rather than Include — the SDK's default globs already pick .css up as None. -->
    <ItemGroup>
        <None Update="jc-communication.tailwind.css" Pack="true" PackagePath="contentFiles\any\any\" PackageCopyToOutput="false" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' == 'true'">
        <ProjectReference Include="..\JC.Communication\JC.Communication.csproj" />
        <ProjectReference Include="..\JC.Web\JC.Web.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' != 'true'">
        <PackageReference Include="JC.Communication" versionOverride="7.1.0"/>
        <PackageReference Include="JC.Web" versionOverride="7.1.0"/>
    </ItemGroup>

    <!-- The README ships in the package: it is the landing page on a feed, and the
         project's front page on GitHub. Update rather than Include - the SDK's default
         globs already pick .md up as None. -->
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
