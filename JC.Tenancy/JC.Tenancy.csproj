<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>JC.Tenancy</PackageId>
        <Version>7.0.0</Version>
        <Description>The application tenancy engine for .NET, usable with or without an identity package and with no dependency on ASP.NET Core. Tenant scope is a scoped ITenantInfo derived live from the current user unless set explicitly, so a request, a background job and a console application all establish it the same way — by identifier, by an already-loaded record, by domain, or through a scope created already scoped. ApplyTenantFilters installs global query filters over every IMultiTenancy entity in a model, matching null to null so the null partition behaves as a partition rather than as no filtering, and refusing at model build where a context cannot say which tenant is current. Those filters bind to ITenantScopedContext on the DbContext rather than closing over ITenantInfo, because EF Core re-reads a captured context on every query and would otherwise bake the tenant that warmed a cached model into every later request. Many contexts may be filtered; exactly one owns tenant storage, and registering a second is an error. ITenantStore is the supported boundary for reading and writing tenants — enforcing unique names and domains, soft-deleting, and invalidating a short-lived memory cache on every write — while Tenant itself carries a domain, user limit, expiry and consumer-defined JSON settings, reported but never enforced. Cross-tenant reads go through AllTenants, gated by configured role names so the engine need not know what an identity package calls its administrator, or AllTenantsUnsafe where there is no user to authorise.</Description>
        <PackageTags>$(PackageTags);multi-tenancy;tenancy;efcore;query-filters;tenant-scoping</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    
    <!-- Deliberately no FrameworkReference on ASP.NET Core. Tenant scope is established through a
         scoped factory rather than middleware, so the engine works unchanged in a request, a
         background job or a console application. -->
    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' == 'true'">
        <ProjectReference Include="..\JC.Core\JC.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' != 'true'">
        <PackageReference Include="JC.Core" />
    </ItemGroup>
    <!-- The README ships in the package: it is the landing page on a feed, and the
         project's front page on GitHub. Update rather than Include - the SDK's default
         globs already pick .md up as None. -->
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>