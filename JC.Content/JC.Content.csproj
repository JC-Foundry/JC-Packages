<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>JC.Content</PackageId>
        <Version>7.1.0</Version>
        <Description>Tools for working with content itself, knowing nothing about where it came from or where it is going — no database, no ASP.NET Core dependency and no configuration, so it behaves identically in a request, a background job and a console application. Profanity moderation folds content the way an evader would: case, accents, repeated letters, punctuation between the letters, leetspeak, masking characters, Cyrillic and Greek look-alikes, and Latin letters standing in for one another. Every fold is recorded and only those that could fabricate a match from innocent text are priced, so a finding carries a confidence percentage rather than a yes or no, and a match inside a longer word or across a word break is capped below the medium band and can never block at any level. ProfanityModerator reports and never alters; ProfanityMasker masks, strips or tags, and only what breached the level in force. Terms come from a curated set and a bundled third-party list, and stay editable at runtime. ContentComparer diffs by line, word or character, splitting losslessly so the segments reconstruct either version and carry indices into both. ContentConverter moves between plain text, Markdown and HTML with HTML as the hub, dropping markup the target cannot express rather than carrying it across, and stripping raw HTML from Markdown at the parser rather than relying on a later sanitise. ContentSanitiser allowlists editor output and narrows data URIs to images, NormalisationHelper keeps the safe Unicode pass separate from the folds that change what was written, and ContentManager runs the lot as a pipeline ordered so that HTML is never the text being scanned.</Description>
        <PackageTags>$(PackageTags);content;moderation;profanity-filter;diff;markdown;html-sanitisation</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AngleSharp" VersionOverride="1.7.1" />
        <PackageReference Include="DiffPlex" VersionOverride="1.7.2" />
        <PackageReference Include="HtmlSanitizer" VersionOverride="9.2.995" />
        <PackageReference Include="Markdig" VersionOverride="1.3.2" />
    </ItemGroup>

    <!-- Embedded rather than copied to output: the shipped term list is a moderation baseline, and a
         file on disk could be emptied or edited after deployment. Applications extend it through the
         registry instead. Verbatim upstream (MIT, github.com/dsojevic/profanity-list) - every
         editorial decision about it lives in ProfanityDataImporter. -->
    <ItemGroup>
        <EmbeddedResource Include="Moderation\Data\en.json" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' == 'true'">
        <ProjectReference Include="..\JC.Core\JC.Core.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalProjectReferences)' != 'true'">
        <PackageReference Include="JC.Core" />
    </ItemGroup>
    <!-- The README ships in the package: it is the landing page on a feed, and the
         project's front page on GitHub. Update rather than Include - the SDK's default
         globs already pick .md up as None. -->
    <ItemGroup>
        <None Update="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
